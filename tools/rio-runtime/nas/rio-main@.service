[Unit]
Description=Rio integrated NAS conversation

[Service]
Type=exec
WorkingDirectory=/home/example/rio-nas-pc-integration-20261012
ExecStart=/usr/bin/python3 -u /home/example/rio-nas-pc-integration-20261012/main.py --text-only
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
Restart=no
TimeoutStopSec=10
